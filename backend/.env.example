# ==============================================================================
# CodeRank Backend Configuration - MongoDB Atlas (Example)
# ==============================================================================

# Server Port
PORT=5001

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Optional: Firebase Service Account Path (if using dual auth/sync)
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# Staggered Cron Sync Schedules
LEETCODE_CRON=0 2 * * *
CODEFORCES_CRON=0 3 * * *
CODECHEF_CRON=0 4 * * *

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

